# Copie para .env somente no computador local e preencha sem versionar.
GOOGLE_MAPS_API_KEY=
APP_USERNAME=ensinoplus
APP_PASSWORD=
APP_SECRET_KEY=
APP_PUBLIC_ACCESS=0
APP_SECURE_COOKIES=0
# Caminho absoluto no volume persistente do EasyPanel:
# LEADS_DB_PATH=/data/leads.db

# Controles de uso/custo (valores em USD são estimativas configuráveis):
API_DAILY_REQUEST_CEILING=100
API_MAX_REQUESTS_PER_SEARCH=30
# Defina manualmente após conferir os preços atuais no Google Cloud.
# Zero mantém o painel de chamadas sem inventar uma estimativa monetária.
GOOGLE_PLACES_TEXT_SEARCH_RATE=0
GOOGLE_PLACES_DETAILS_RATE=0
EMAIL_MX_CHECK=1

# Integração manual com o Brevo. Nunca versione valores reais.
BREVO_API_KEY=
# Senha exclusiva para desbloquear ações Brevo na interface pública.
BREVO_SYNC_PASSWORD=
